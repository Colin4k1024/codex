{
  "name": "@codex/app-server-protocol",
  "private": true,
  "version": "0.1.0",
  "description": "Generated TypeScript contract for the Codex app-server v2 protocol",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.json",
    "check": "node scripts/check-protocol.mjs",
    "test": "pnpm run build && tsc -p tsconfig.test.json && vitest run",
    "update-revision": "node scripts/update-revision.mjs"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
