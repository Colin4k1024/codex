{
  "name": "codex-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Electron desktop client for Codex app-server",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "build": "pnpm run protocol:build && esbuild src/preload/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload/index.js && esbuild src/main/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/main/index.js && vite build",
    "dev": "tsc -p tsconfig.node.json && concurrently -k \"vite\" \"wait-on tcp:127.0.0.1:5173 && electron .\"",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint .",
    "test": "pnpm run protocol:build && vitest run",
    "test:electron": "electron . --smoke",
    "typecheck": "pnpm run protocol:build && tsc --noEmit",
    "protocol:build": "pnpm --filter @codex/app-server-protocol... build",
    "test:visual": "playwright test"
  },
  "dependencies": {
    "@codex/app-server-protocol": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.6.1",
    "axe-core": "^4.14.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "esbuild": "0.28.1",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.6",
    "prettier": "^3.4.2",
    "tailwind-merge": "^2.6.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  }
}
