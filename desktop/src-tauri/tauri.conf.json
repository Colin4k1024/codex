{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YourAgent",
  "version": "0.1.0",
  "identifier": "com.youragent.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "YourAgent",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "Developer ID Application: Haier Electric Appliance International Co., Ltd. (KRV5T3384C)",
      "hardenedRuntime": true,
      "minimumSystemVersion": "10.15"
    }
  }
}