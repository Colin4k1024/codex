{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Workflow",
  "type": "object",
  "required": [
    "id",
    "nodes",
    "schema_version",
    "version"
  ],
  "properties": {
    "artifacts": {
      "default": {},
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/ArtifactSpec"
      }
    },
    "gates": {
      "default": {},
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/Gate"
      }
    },
    "id": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Node"
      }
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "variables": {
      "default": {},
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/VariableSpec"
      }
    },
    "version": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "ArtifactSpec": {
      "type": "object",
      "required": [
        "media_type",
        "path"
      ],
      "properties": {
        "media_type": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "schema_ref": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "Gate": {
      "type": "object",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "argv",
            "kind"
          ],
          "properties": {
            "argv": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "expect_exit_code": {
              "default": 0,
              "type": "integer",
              "format": "int32"
            },
            "kind": {
              "type": "string",
              "enum": [
                "command"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "artifact",
            "kind",
            "schema_ref"
          ],
          "properties": {
            "artifact": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "artifact_schema"
              ]
            },
            "schema_ref": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "prompt"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "approval"
              ]
            },
            "prompt": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ],
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        }
      }
    },
    "Node": {
      "type": "object",
      "oneOf": [
        {
          "description": "Team command reference (resolved against the pack command catalog).",
          "type": "object",
          "required": [
            "command_ref",
            "type"
          ],
          "properties": {
            "command_ref": {
              "type": "string"
            },
            "inputs": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "outputs": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "type": {
              "type": "string",
              "enum": [
                "capability"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Executable program; success requires every listed gate to pass.",
          "type": "object",
          "required": [
            "argv",
            "gates",
            "type"
          ],
          "properties": {
            "argv": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "gates": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "type": {
              "type": "string",
              "enum": [
                "verification"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Retry loop: must carry max_attempts, wall_timeout and an explicit gate.",
          "type": "object",
          "required": [
            "body",
            "gate",
            "max_attempts",
            "type",
            "wall_timeout_secs"
          ],
          "properties": {
            "body": {
              "type": "string"
            },
            "gate": {
              "type": "string"
            },
            "max_attempts": {
              "type": "integer",
              "format": "uint32",
              "minimum": 1.0
            },
            "type": {
              "type": "string",
              "enum": [
                "loop"
              ]
            },
            "wall_timeout_secs": {
              "type": "integer",
              "format": "uint64",
              "minimum": 1.0
            }
          },
          "additionalProperties": false
        }
      ],
      "required": [
        "id"
      ],
      "properties": {
        "budget_tokens": {
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "depends_on": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "id": {
          "type": "string"
        },
        "model": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "VarType": {
      "type": "string",
      "enum": [
        "string",
        "number",
        "bool",
        "path"
      ]
    },
    "VariableSpec": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "default": {
          "default": null
        },
        "required": {
          "default": false,
          "type": "boolean"
        },
        "type": {
          "$ref": "#/definitions/VarType"
        }
      },
      "additionalProperties": false
    }
  }
}
